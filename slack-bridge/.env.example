# Slack App(api.slack.com/apps) 설정 화면에서 복사
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
# Socket Mode 사용 시(터널 없이 실행 가능, 권장 - App-Level Token 필요, connections:write scope)
SLACK_APP_TOKEN=xapp-...
USE_SOCKET_MODE=true

# tc-automation 저장소 루트 (git 커밋/푸시 대상)
TC_AUTOMATION_ROOT=D:/QA/tc-automation

# Claude Code가 AGENTS.md/스킬을 자동으로 읽어들이는 작업 디렉터리
CLAUDE_WORKDIR=D:/QA/tc-automation/agents-config

# claude CLI 실행 파일 경로 (where.exe claude 로 확인 후 지정, 비워두면 PATH의 "claude" 사용)
CLAUDE_BIN=claude

# 이 서버를 외부에서 접근 가능하게 노출할 때 사용한 주소 (Socket Mode면 불필요, HTTP 모드일 때만 참고용으로 기록)
PUBLIC_BASE_URL=

# 서버 포트 (HTTP/Events API 모드일 때만 사용)
PORT=3000

# [선택] 서버 크래시/개별 요청 오류/CLI가 is_error로 응답한 경우 알림을 받을 Slack Incoming Webhook URL
# 발급: api.slack.com/apps → 해당 앱 선택 → Incoming Webhooks 활성화 → Add New Webhook to Workspace
# 비워두면 알림 기능은 조용히 비활성화됩니다.
SLACK_ERROR_WEBHOOK_URL=

# [선택] 알림 메시지에 스레드 바로가기 링크를 포함하려면 워크스페이스 서브도메인 지정 (예: bong-hmf5032)
SLACK_WORKSPACE_DOMAIN=

# [선택] 평일(월~금) 10:00(KST) 자동 노션 현황 보고 (큐돌이/Claude QA 자동화 페이지). 끄려면 false로 설정.
# 비워두면 기본 활성화(true)됩니다.
DAILY_REPORT_ENABLED=

